{
    "name":  "dsh-ecommerce-analysis",
    "version":  "1.2.0",
    "type":  "module",
    "description":  "A DSH skill plugin for e-commerce order analysis: refund-type classification, return-rate statistics, interception and refund-abuse loss accounting, after-sales deep analysis with product warnings, and a single integrated Excel workbook (5 sheets, ~14 charts) plus monthly comparison and Chinese New Year window reports.",
    "keywords":  [
                     "dsh-plugin",
                     "dsh",
                     "ecommerce",
                     "e-commerce",
                     "order-analysis",
                     "return-rate",
                     "skill"
                 ],
    "license":  "MIT",
    "repository":  {
                       "type":  "git",
                       "url":  "git+https://github.com/jinkuihua/dsh-ecommerce-analysis.git"
                   },
    "exports":  {
                    ".":  "./index.js",
                    "./locale/*.json":  "./locale/*.json",
                    "./icon":  "./icon.svg"
                },
    "files":  [
                  "index.js",
                  "cordis.patch.yml",
                  "locale/*.json",
                  "icon.svg",
                  "icon.png",
                  "README.md",
                  "LICENSE"
              ],
    "dsh":  {
                "bundle":  {
                               "patch":  "./cordis.patch.yml"
                           }
            }
}